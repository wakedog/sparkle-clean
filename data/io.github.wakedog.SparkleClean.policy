<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Sparkle Clean</vendor>
  <icon_name>io.github.wakedog.SparkleClean</icon_name>

  <action id="io.github.wakedog.SparkleClean.clean-system">
    <description>Clean up system files</description>
    <message>Authentication is required to remove package caches, unused packages, old logs and other system files</message>
    <icon_name>io.github.wakedog.SparkleClean</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sparkle-clean/sparkle-clean-helper</annotate>
  </action>
</policyconfig>
